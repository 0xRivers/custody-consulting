[Unit]
Description=Custody Consulting static backend
After=network.target

[Service]
User=custody-deploy
Group=custody-deploy
ExecStart=/usr/local/bin/caddy run --config /etc/custody-consulting/Caddyfile --adapter caddyfile
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/custody-consulting
Environment=HOME=/srv/custody-consulting

[Install]
WantedBy=multi-user.target
