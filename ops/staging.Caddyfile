# Separate static backend; the existing public Caddy remains the TLS proxy.
{
    admin off
    auto_https off
    persist_config off
}
http://:8008 {
    bind 127.0.0.1
    root * /srv/custody-consulting-staging/current
    encode zstd gzip
    header Cache-Control "no-cache"
    header X-Robots-Tag "noindex, nofollow, noarchive"
    file_server
}
