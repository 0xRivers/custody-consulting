[Unit]
Description=Custody Consulting static backend
After=network.target

[Service]
User=custody-staging
Group=custody-staging
ExecStart=/usr/local/bin/caddy run --config /etc/custody-consulting-staging/Caddyfile --adapter caddyfile
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/custody-consulting-staging
Environment=HOME=/srv/custody-consulting-staging

[Install]
WantedBy=multi-user.target
