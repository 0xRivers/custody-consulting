# Separate static backend; the existing public Caddy remains the TLS proxy.
{
    admin off
    auto_https off
    persist_config off
}
http://:8004 {
    bind 127.0.0.1
    root * /srv/custody-consulting/current
    encode zstd gzip
    @immutable path /_astro/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"
    @mutable not path /_astro/*
    header @mutable Cache-Control "no-cache"
    file_server
}
