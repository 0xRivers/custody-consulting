---
import Base from '../layouts/Base.astro';
import {buildEnvironment} from '../../environment.mjs';
const enabled = (buildEnvironment(process.env.SITE_ENV).name === 'staging' || process.env.BOOKING_PAGES_ENABLED === 'true');
const contentEnabled = process.env.CONTENT_CMS_ENABLED === 'true';
---
<Base title="Admin · Custody Consulting" noindex={true}>
  <main aria-label="Custody Consulting admin">
    {enabled ? <>
      <div id="sign-in" class="sign-in">
        <div>
          <button id="connect" class="primary" type="button">Connect with Nostr</button>
          <p id="status" class="status" role="status" aria-live="polite"></p>
        </div>
      </div>

      <div id="workspace" class="workspace" hidden>
        <aside class="sidebar">
          <div class="brand">
            <span class="brand-mark" aria-hidden="true">C</span>
            <div><strong>Custody Consulting</strong><small>Admin workspace</small></div>
          </div>
          <nav aria-label="Admin sections">
            <button type="button" data-section="invitations" aria-controls="invitations-panel" aria-current="page">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
              Invitations
            </button>
            <button type="button" data-section="sales" aria-controls="sales-panel">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4v16h16M9 15v-4m5 4V7m5 8v-6"/></svg>
              Sales
            </button>
            <button type="button" data-section="review" aria-controls="review-panel">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 9 17H3L12 3Zm0 6v4m0 3h.01"/></svg>
              Payment review
            </button>
            {contentEnabled && <a href="/admin/content/">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h10l4 4v14H5zM14 3v5h5M8 12h8m-8 4h6"/></svg>
              Content
            </a>}
          </nav>
          <div class="account">
            <span id="identity"></span>
            <button id="disconnect" type="button">Disconnect</button>
          </div>
        </aside>

        <div class="content">
          <div id="workspace-status"></div>
          <section id="invitations-panel" aria-labelledby="invitations-title">
            <header class="section-heading">
              <h1 id="invitations-title">Invitations</h1>
              <p>Create a private link for one Foundation booking.</p>
            </header>
            <div class="surface invitation">
              <form id="invite-form">
                <div>
                  <label for="locale">Booking language</label>
                  <select id="locale"><option value="pl">Polski</option><option value="en">English</option></select>
                </div>
                <button id="create" class="primary" type="submit">Create invitation</button>
              </form>
              <div id="result" class="invite-result" hidden>
                <label for="invite-url">Private booking link</label>
                <div class="field-action">
                  <input id="invite-url" type="text" readonly />
                  <button id="copy" type="button">Copy link</button>
                </div>
                <p id="expiry"></p>
              </div>
            </div>
          </section>

          <section id="sales-panel" aria-labelledby="sales-title" hidden>
            <header class="section-heading">
              <div><h1 id="sales-title">Sales</h1><p>Confirmed bookings and payment totals.</p></div>
              <button id="load-sales" type="button">Load sales</button>
            </header>
            <div id="sales-data"></div>
            <details id="refund-tools" class="surface refund-tools" hidden>
              <summary>Refund claim link</summary>
              <label for="refund-link">Existing BTCPay claim URL</label>
              <div class="field-action">
                <input id="refund-link" type="url" autocomplete="off" spellcheck="false" />
                <button id="copy-refund" type="button">Copy public link</button>
              </div>
              <p>Share privately with the intended recipient. Approve payouts in BTCPay.</p>
            </details>
          </section>

          <section id="review-panel" aria-labelledby="review-title" hidden>
            <header class="section-heading">
              <div><h1 id="review-title">Payment review</h1><p>Check payments that need manual follow-up.</p></div>
              <button id="load-reviews" type="button">Load queue</button>
            </header>
            <div id="review-list"></div>
          </section>
        </div>
      </div>
    </> : <div class="sign-in"><p>Invite administration is available on staging only.</p></div>}
  </main>
  <style>
    [hidden] {display:none!important;}
    .sign-in {min-height:100dvh;display:grid;place-items:center;padding:1rem;text-align:center;}
    .sign-in > div {position:relative;}
    .sign-in .status {position:absolute;top:100%;left:50%;width:min(24rem,calc(100vw - 2rem));transform:translateX(-50%);}
    .workspace {display:grid;grid-template-columns:15rem minmax(0,1fr);min-height:100dvh;}
    .sidebar {position:sticky;top:0;height:100dvh;display:flex;flex-direction:column;gap:2rem;padding:1.4rem 1rem;background:var(--navy-card);border-right:1px solid var(--line);}
    .brand {display:flex;align-items:center;gap:.65rem;padding:0 .25rem;}
    .brand strong,.brand small {display:block;}
    .brand strong {font-size:.875rem;line-height:1.2;}
    .brand small {font-size:.75rem;color:var(--muted);margin-top:.18rem;}
    .brand-mark {display:grid;place-items:center;width:2rem;height:2rem;flex:none;border-radius:.5rem;background:var(--orange);color:var(--ink);font-weight:800;}
    nav {display:grid;gap:.25rem;}
    nav button {display:flex;align-items:center;gap:.65rem;width:100%;text-align:left;border-color:transparent;background:transparent;color:var(--muted);}
    nav a {display:flex;align-items:center;gap:.65rem;padding:.55rem .75rem;border:1px solid transparent;border-radius:.5rem;color:var(--muted);text-decoration:none;font-weight:650;}
    nav a:hover {border-color:var(--line);color:var(--white);}
    nav button[aria-current] {background:var(--navy-soft);border-color:var(--line);color:var(--white);}
    nav svg {width:1.1rem;height:1.1rem;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex:none;}
    nav button[aria-current] svg {color:var(--orange);}
    .account {margin-top:auto;border-top:1px solid var(--line);padding:.75rem .25rem 0;display:flex;flex-wrap:wrap;align-items:center;gap:.25rem .55rem;}
    .account span {color:var(--muted);font-size:.75rem;font-family:ui-monospace,monospace;}
    .account button {padding:.35rem .45rem;font-size:.75rem;background:transparent;border-color:transparent;}
    .content {width:100%;max-width:76rem;min-width:0;padding:clamp(1rem,4vw,3rem);}
    .section-heading {display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.75rem;margin-bottom:1.5rem;}
    h1 {margin:0;font-size:clamp(1.75rem,4vw,2.4rem);line-height:1.15;letter-spacing:-.035em;}
    p {color:var(--muted);margin:.5rem 0;}
    button,select,input {font:inherit;border-radius:.5rem;border:1px solid var(--line);padding:.55rem .75rem;}
    button {color:var(--white);background:var(--navy-card);font-weight:650;cursor:pointer;}
    button:hover:not(:disabled) {border-color:var(--muted);}
    button:disabled {opacity:.55;cursor:wait;}
    button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible {outline:2px solid var(--orange);outline-offset:2px;}
    .primary {background:var(--orange);border-color:transparent;color:var(--ink);}
    input,select {min-width:0;background:var(--navy-soft);color:var(--white);}
    input {width:100%;}
    label {display:block;font-size:.875rem;font-weight:650;margin-bottom:.4rem;}
    .surface,.content :global(.review-card) {background:var(--navy-card);border:1px solid var(--line);border-radius:.8rem;padding:1.25rem;}
    .invitation {max-width:42rem;}
    form,.field-action {display:flex;align-items:end;gap:.65rem;}
    .field-action button {flex:none;}
    .invite-result {margin-top:1.25rem;padding-top:1.25rem;border-top:1px solid var(--line);}
    .invite-result p,.refund-tools p {font-size:.8rem;}
    .status {margin:0 0 1rem;font-size:.875rem;color:var(--white);padding:.65rem .8rem;border:1px solid var(--line);border-radius:.5rem;background:var(--navy-card);}
    .sign-in .status {margin:.65rem 0 0;}
    .status:empty {display:none;}
    .refund-tools {margin-top:1.25rem;}
    .refund-tools summary {font-weight:650;cursor:pointer;}
    .refund-tools label {margin-top:1rem;}
    #review-list {display:grid;gap:.75rem;}
    .content :global(.review-card) {overflow-wrap:anywhere;}
    .content :global(.review-card h3) {margin:0 0 .6rem;font-size:1.05rem;}
    .content :global(.review-card p) {font-size:.875rem;}
    .content :global(.review-card label) {margin-top:1rem;}
    .content :global(.review-card input) {max-width:20rem;}
    .content :global(.review-card button) {margin:.65rem .5rem 0 0;}
    :global(.sales-context) {font-size:.8rem;margin-bottom:.75rem;}
    :global(.sales-grid) {display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,12rem),1fr));gap:.75rem;margin-bottom:1.25rem;}
    :global(.sales-tile) {border:1px solid var(--line);background:var(--navy-card);border-radius:.8rem;padding:1rem;}
    :global(.sales-tile strong) {display:block;font-size:1.45rem;margin:.25rem 0;}
    :global(.sales-tile small) {display:block;color:var(--muted);}
    :global(.sales-list) {border:1px solid var(--line);background:var(--navy-card);border-radius:.8rem;padding:1rem 1.25rem;}
    :global(.sales-list h2) {font-size:1rem;margin:0 0 .5rem;}
    :global(.sales-list details) {border-top:1px solid var(--line);padding:.6rem 0;overflow-wrap:anywhere;}
    :global(.sales-list summary) {cursor:pointer;}
    :global(.sales-list p) {font-size:.8rem;}
    @media (max-width:43rem) {
      .workspace {grid-template-columns:minmax(0,1fr);}
      .sidebar {z-index:1;height:auto;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.55rem;padding:.75rem 1rem;border-right:0;border-bottom:1px solid var(--line);}
      .account {grid-column:2;grid-row:1;padding:0;border:0;margin:0;}
      .account span,.brand small,nav svg {display:none;}
      nav {grid-column:1/-1;display:flex;flex-wrap:wrap;gap:.25rem;}
      nav button,nav a {width:auto;font-size:.875rem;white-space:nowrap;}
      .content {padding:1.25rem 1rem;}
      .field-action {flex-wrap:wrap;}
      .field-action input {flex-basis:100%;}
    }
  </style>
  <script>
    import {generateSecretKey, getPublicKey, type EventTemplate} from 'nostr-tools/pure';
    import {BunkerSigner, createNostrConnectURI} from 'nostr-tools/nip46';
    import {npubEncode} from 'nostr-tools/nip19';
    import {SimplePool} from 'nostr-tools/pool';
    type SignedEvent = {pubkey:string;id:string;sig:string;kind:number;created_at:number;tags:string[][];content:string};
    type AdminSigner = {getPublicKey:()=>Promise<string>;signEvent:(event:EventTemplate)=>Promise<SignedEvent>};
    const browserSigner = () => (window as Window & {nostr?:AdminSigner}).nostr;
    const android = /Android/i.test(navigator.userAgent);
    const relays = ['wss://relay.nip46.com', 'wss://relay.nsec.app'];
    let activeSigner: AdminSigner | undefined;
    let closeAmber: (() => void) | undefined;
    async function waitForAmber<T>(request: Promise<T>): Promise<T> {
      let timeout: ReturnType<typeof setTimeout> | undefined;
      try {
        return await Promise.race([request, new Promise<never>((_, reject) => {
          timeout = setTimeout(() => reject(new Error('Amber did not respond in time. Open Amber or reconnect and try again.')), 110000);
        })]);
      } finally { clearTimeout(timeout); }
    }
    function prepareAmber() {
      const key = generateSecretKey();
      const pool = new SimplePool({maxWaitForConnection:8000});
      const uri = createNostrConnectURI({
        clientPubkey: getPublicKey(key),
        relays,
        secret: Array.from(crypto.getRandomValues(new Uint8Array(16)), byte => byte.toString(16).padStart(2, '0')).join(''),
        perms: ['sign_event:27235'],
        name: 'Custody Consulting Admin',
        url: location.origin,
      });
      const attempt = {
        intent: 'intent://' + uri.slice('nostrconnect://'.length) +
          '#Intent;scheme=nostrconnect;package=com.greenart7c3.nostrsigner;end',
        failed: false,
        close: () => pool.destroy(),
        signer: BunkerSigner.fromURI(key, uri, {pool, skipSwitchRelays:true}),
      };
      // The relay can fail before the user taps. Handle that rejection and retry on tap.
      void attempt.signer.catch(() => { attempt.failed = true; });
      return attempt;
    }
    async function connectAmber(): Promise<AdminSigner> {
      if (pendingAmber?.failed) {
        pendingAmber.close();
        pendingAmber = undefined;
      }
      const attempt = pendingAmber ?? prepareAmber();
      pendingAmber = undefined;
      closeAmber = attempt.close;
      status.textContent = 'Approve the connection in Amber.';
      // Launch synchronously within the original button tap so Chrome allows the handoff.
      location.href = attempt.intent;
      const signer = await waitForAmber(attempt.signer.catch(() => {
        throw new Error('Amber could not connect through the Nostr relays. Tap Connect with Nostr to retry.');
      }));
      return {
        getPublicKey: () => waitForAmber(signer.getPublicKey()),
        signEvent: event => waitForAmber(signer.signEvent(event)),
      };
    }
    const connect = document.getElementById('connect') as HTMLButtonElement | null;
    const identity = document.getElementById('identity');
    // Listen before the tap so Amber can reply even while the browser is in the background.
    let pendingAmber = android && connect ? prepareAmber() : undefined;
    const form = document.getElementById('invite-form') as HTMLFormElement;
    const workspace = document.getElementById('workspace');
    const navigation = Array.from(document.querySelectorAll<HTMLButtonElement>('button[data-section]'));
    const loadedSections = new Set<string>();
    for (const button of navigation) {
      button.addEventListener('click', () => {
        status.textContent = '';
        for (const item of navigation) {
          const active = item === button;
          if (active) item.setAttribute('aria-current', 'page');
          else item.removeAttribute('aria-current');
          document.getElementById(item.getAttribute('aria-controls')!)!.hidden = !active;
        }
        const section = button.dataset.section!;
        if (!loadedSections.has(section)) {
          if (section === 'sales') document.getElementById('load-sales')!.click();
          if (section === 'review') document.getElementById('load-reviews')!.click();
        }
      });
    }
    document.getElementById('disconnect')?.addEventListener('click', () => {
      closeAmber?.();
      location.reload();
    });
    const status = document.getElementById('status')!;
    const create = document.getElementById('create') as HTMLButtonElement;
    const result = document.getElementById('result')!;
    const url = document.getElementById('invite-url') as HTMLInputElement;
    let pubkey = '', busy = false;
    let refundOrigin = '';
    const messages:Record<string,string> = {
      RESOLUTION_BLOCKED:'This case cannot be resolved automatically. Check payment and original booking in BTCPay and Cal.',
      RESOLUTION_NEEDS_REVIEW:'A previous booking attempt needs manual inspection. Do not create another replacement.',
      RESOLUTION_PREVIEW_CHANGED:'The preview changed. Check availability and preview again.',
      SLOT_UNAVAILABLE:'That appointment time is no longer available. Choose another agreed time.',
      PAYMENT_NOT_READY:'The full payment must be verified as confirmed before resolving this booking.',
      ADMIN_NOT_ALLOWED:'This Nostr account is not approved. Ask the site owner to add your npub.',
      ADMIN_RATE_LIMIT:'Too many requests. Please try again later.',
      ADMIN_CHALLENGE_EXPIRED:'The signing request expired or was already used. Please try again.',
      ADMIN_INVALID_SIGNATURE:'The signature could not be verified. Please reconnect your signer.',
    };
    async function api(body:unknown) {
      const prefix=location.pathname.startsWith('/lightning-pilot/')?'/lightning-pilot':'';
      const response = await fetch(prefix+'/booking-api/checkout', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body),cache:'no-store',signal:AbortSignal.timeout(15000)});
      const data = await response.json();
      if(!response.ok) throw new Error(messages[data.error] || 'Could not complete the request. Please try again.');
      return data;
    }
    async function connectSigner() {
      if (!connect || connect.disabled) return;
      connect.disabled=true;
      status.textContent='';
      try {
        const provider = android ? await connectAmber() : browserSigner();
        if(!provider) throw new Error('No Nostr browser signer found. Enable a NIP-07 signer, or open this page on Android with Amber installed.');
        pubkey=await provider.getPublicKey();
        // Allowlist checked by the server; obtaining a public key is not authentication.
        await api({action:'admin-challenge',pubkey,locale:(document.getElementById('locale') as HTMLSelectElement).value});
        activeSigner=provider;
        const npub = npubEncode(pubkey);
        identity!.textContent = npub.slice(0, 10)+'…'+npub.slice(-5);
        identity!.title = npub;
        workspace!.hidden = false;
        document.getElementById('workspace-status')!.appendChild(status);
        document.getElementById('sign-in')!.hidden = true;
        status.textContent = '';
        navigation[0].focus();
      } catch(error) {
        pubkey=''; closeAmber?.(); closeAmber=undefined;
        if (android) pendingAmber = prepareAmber();
        status.textContent=error instanceof Error?error.message:'Could not connect.';
      }
      finally {connect.disabled=false;}
    }
    connect?.addEventListener('click', () => void connectSigner());
    form?.addEventListener('submit',async event=> {
      event.preventDefault(); if(busy || !pubkey)return;
      busy=true;create.disabled=true;connect!.disabled=true;result.hidden=true;
      try {
        const provider=activeSigner;if(!provider)throw new Error('Reconnect your Nostr signer.');
        const locale=(document.getElementById('locale') as HTMLSelectElement).value;
        status.textContent='Approve the invitation request in your signer…';
        const challenge=await api({action:'admin-challenge',pubkey,locale});
        const signed=await provider.signEvent(challenge.event);
        const invite=await api({action:'admin-invite',locale,event:signed});
        url.value=invite.url;result.hidden=false;
        document.getElementById('expiry')!.textContent='Valid until '+new Date(invite.expiresAt).toLocaleString()+'.';
        status.textContent='Invitation created.';
      } catch(error) {status.textContent=error instanceof Error?error.message:'Could not create an invitation.';}
      finally {busy=false;create.disabled=false;connect!.disabled=false;}
    });
    async function signedResolution(purpose:string,request:Record<string,string>) {
      const provider=activeSigner;if(!provider)throw new Error('Reconnect your Nostr signer.');
      const challenge=await api({action:'admin-challenge',pubkey,locale:'en',purpose,request});
      return provider.signEvent(challenge.event);
    }
    type Sale = {provider:string;settledRail:string|null;currency:string;minorUnits:number};
    function saleMethod(sale:Sale) {
      if (sale.provider === 'stripe') return 'Stripe';
      if (sale.settledRail === 'lightning') return 'Lightning';
      if (sale.settledRail === 'onchain') return 'Bitcoin on-chain';
      return 'Bitcoin · method unrecorded';
    }
    function saleAmount(sale:Sale) {
      return new Intl.NumberFormat(undefined,{style:'currency',currency:sale.currency}).format(sale.minorUnits/100);
    }
    const loadSales = document.getElementById('load-sales') as HTMLButtonElement | null;
    loadSales?.addEventListener('click',async()=> {
      if (busy || !activeSigner) return;
      busy=true;loadSales.disabled=true;connect!.disabled=true;create.disabled=true;
      const panel=document.getElementById('sales-data')!;
      try {
        status.textContent='Approve access to sales in your signer…';
        const event=await signedResolution('sales',{});
        const data=await api({action:'admin-sales',locale:'en',event});
        panel.replaceChildren();
        const context=document.createElement('p');
        context.className='sales-context';
        context.textContent=data.environment+' · Gross totals before refunds and provider fees';
        panel.appendChild(context);
        const totals=document.createElement('div');
        totals.className='sales-grid';
        for (const total of data.totals) {
          const tile=document.createElement('div');
          tile.className='sales-tile';
          const method=document.createElement('small');
          method.textContent=saleMethod(total);
          const amount=document.createElement('strong');
          amount.textContent=saleAmount(total);
          const count=document.createElement('small');
          count.textContent=total.count+(total.count===1?' booking':' bookings');
          tile.append(method,amount,count);
          if (total.satsCount) {
            const sats=document.createElement('small');
            sats.textContent=total.sats.toLocaleString()+' sats · '+total.satsCount+' verified';
            tile.appendChild(sats);
          }
          totals.appendChild(tile);
        }
        if (totals.childElementCount) panel.appendChild(totals);
        const list=document.createElement('div');
        list.className='sales-list';
        const heading=document.createElement('h2');
        heading.textContent=data.recent.length?'Recent bookings':'No confirmed bookings';
        list.appendChild(heading);
        for (const sale of data.recent) {
          const entry=document.createElement('details');
          const summary=document.createElement('summary');
          summary.textContent=saleAmount(sale)+' · '+saleMethod(sale);
          const identifiers=document.createElement('p');
          identifiers.textContent='Booking '+sale.reference+' · Payment '+sale.paymentId;
          entry.append(summary,identifiers);
          list.appendChild(entry);
        }
        panel.appendChild(list);
        refundOrigin=data.refundOrigin || '';
        document.getElementById('refund-tools')!.hidden=!refundOrigin;
        loadedSections.add('sales');
        loadSales.textContent='Refresh';
        status.textContent='';
      } catch(error) {status.textContent=error instanceof Error?error.message:'Could not load sales.';}
      finally {busy=false;loadSales.disabled=false;connect!.disabled=false;create.disabled=false;}
    });
    document.getElementById('copy-refund')?.addEventListener('click',async()=> {
      const input=document.getElementById('refund-link') as HTMLInputElement;
      const claim=URL.canParse(input.value.trim()) ? new URL(input.value.trim()) : null;
      if (!refundOrigin || !claim || !['http:','https:'].includes(claim.protocol) ||
          claim.username || claim.password || !/^\/pull-payments\/[A-Za-z0-9]{1,100}\/?$/.test(claim.pathname)) {
        status.textContent='Paste the existing BTCPay refund claim URL.';
        return;
      }
      input.value=refundOrigin+claim.pathname;
      try {await navigator.clipboard.writeText(input.value);status.textContent='Refund link copied.';}
      catch {input.select();status.textContent='Copy the public refund link from the field.';}
    });
    const reviewsButton=document.getElementById('load-reviews') as HTMLButtonElement;
    reviewsButton?.addEventListener('click',async()=> {
      if(busy||!pubkey)return;
      busy=true;reviewsButton.disabled=true;create.disabled=true;connect!.disabled=true;
      const list=document.getElementById('review-list')!;list.replaceChildren();
      try {
        status.textContent='Approve access to the review queue in your signer…';
        const event=await signedResolution('reviews',{});
        const data=await api({action:'admin-reviews',locale:'en',event});
        const labels:Record<string,string>={'late-payment':'Payment received after expiry','partial-payment':'Partial payment','overpayment':'Overpayment','invalid-payment':'Invalid payment','manually-marked':'Manually marked invoice','payment-check':'Payment needs checking'};
        for(const item of data.reviews) {
          const card=document.createElement('article');card.className='review-card';
          const heading=document.createElement('h3');heading.textContent=labels[item.reason]||labels['payment-check'];card.appendChild(heading);
          for(const line of [
            'Invoice: '+item.invoiceId,'Booking reference: '+item.reference,
            'Original appointment: '+new Date(item.startsAt).toLocaleString(),
            item.slotReleased?'Original slot was released. Check current availability before offering it again.':'Booking status needs checking in Cal.',
            'BTCPay status at last webhook: '+item.invoiceStatus,
            'Last detected: '+new Date(item.lastSeen).toLocaleString(),
          ]) {const p=document.createElement('p');p.textContent=line;card.appendChild(p);}
          if(item.reason==='late-payment') {
            const label=document.createElement('label');label.textContent='Agreed appointment time ('+Intl.DateTimeFormat().resolvedOptions().timeZone+')';
            const time=document.createElement('input');time.type='datetime-local';
            const date=new Date(item.startsAt);time.value=new Date(date.getTime()-date.getTimezoneOffset()*60000).toISOString().slice(0,16);label.appendChild(time);card.appendChild(label);
            const previewButton=document.createElement('button');previewButton.type='button';previewButton.textContent='Preview paid booking';card.appendChild(previewButton);
            const previewArea=document.createElement('div');card.appendChild(previewArea);
            time.addEventListener('input',()=>previewArea.replaceChildren());
            previewButton.addEventListener('click',async()=> {
              if(busy)return;busy=true;previewButton.disabled=true;previewArea.replaceChildren();
              try {
                const start=new Date(time.value).toISOString();
                const signedPreview=await signedResolution('resolve-preview',{reference:item.reference,start});
                const preview=await api({action:'admin-resolve-preview',locale:'en',event:signedPreview});
                const summary=document.createElement('p');summary.textContent='Confirm '+preview.attendee.name+' ('+preview.attendee.email+') for '+new Date(preview.start).toLocaleString()+'. Email language: '+preview.attendee.language+'. The existing payment will be used; Cal will send a confirmation email.';previewArea.appendChild(summary);
                const approve=document.createElement('button');approve.type='button';approve.textContent='Confirm appointment using existing payment';previewArea.appendChild(approve);
                approve.addEventListener('click',async()=> {
                  if(busy)return;busy=true;approve.disabled=true;
                  try {
                    const event=await signedResolution('resolve-confirm',{reference:item.reference,start:preview.start,previewHash:preview.previewHash});
                    await api({action:'admin-resolve-confirm',locale:'en',event});
                    previewArea.textContent='Appointment confirmed. Cal has handled the confirmation email. The client’s original result page now shows the confirmed appointment.';
                    previewButton.hidden=true;time.disabled=true;
                  } catch(error) {status.textContent=error instanceof Error?error.message:'Could not resolve booking.';approve.disabled=false;}
                  finally {busy=false;}
                });
                status.textContent='Preview ready. Check the attendee and agreed time before confirming.';
              } catch(error) {status.textContent=error instanceof Error?error.message:'Could not preview booking.';}
              finally {busy=false;previewButton.disabled=false;}
            });
          }
          list.appendChild(card);
        }
        if (!data.reviews.length) {
          const empty=document.createElement('p');
          empty.textContent='No payments need review.';
          list.appendChild(empty);
        }
        loadedSections.add('review');
        reviewsButton.textContent='Refresh';
        status.textContent='';
      } catch(error) {status.textContent=error instanceof Error?error.message:'Could not load reviews.';}
      finally {busy=false;reviewsButton.disabled=false;create.disabled=false;connect!.disabled=false;}
    });
    document.getElementById('copy')?.addEventListener('click',async()=> {
      try {await navigator.clipboard.writeText(url.value);status.textContent='Link copied.';}
      catch {url.select();status.textContent='Select and copy the link above.';}
    });
  </script>
</Base>
