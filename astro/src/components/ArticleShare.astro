---
import type { Locale } from '../lib/i18n';

interface Props { lang: Locale; title: string }
const { lang, title } = Astro.props;
const labels = lang === 'pl'
  ? { share: 'Udostępnij', copy: 'Kopiuj link', copied: 'Link skopiowany.', manual: 'Zaznacz i skopiuj link.', url: 'Link do artykułu', failed: 'Nie udało się otworzyć udostępniania. Użyj przycisku Kopiuj link.' }
  : { share: 'Share article', copy: 'Copy link', copied: 'Link copied.', manual: 'Select and copy the link.', url: 'Article link', failed: 'Sharing could not open. Use Copy link.' };
---
<div class="article-share" data-article-share data-title={title}
  data-copied={labels.copied} data-manual={labels.manual} data-failed={labels.failed}>
  <div class="article-share__buttons" hidden>
    <button type="button" data-share hidden>{labels.share}</button>
    <button type="button" data-copy>{labels.copy}</button>
  </div>
  <p class="article-share__status" role="status" aria-live="polite"></p>
  <label class="article-share__manual" hidden>
    {labels.url}
    <input type="url" readonly />
  </label>
</div>

<script>
  for (const container of document.querySelectorAll<HTMLElement>('[data-article-share]')) {
    const buttons = container.querySelector<HTMLElement>('.article-share__buttons')!;
    const share = container.querySelector<HTMLButtonElement>('[data-share]')!;
    const copy = container.querySelector<HTMLButtonElement>('[data-copy]')!;
    const status = container.querySelector<HTMLElement>('[role="status"]')!;
    const manual = container.querySelector<HTMLElement>('.article-share__manual')!;
    const input = container.querySelector<HTMLInputElement>('input')!;
    const url = new URL(location.pathname, location.origin).href;
    const data = { title: container.dataset.title, url };
    buttons.hidden = false;
    share.hidden = typeof navigator.share !== 'function';

    share.addEventListener('click', async () => {
      share.disabled = true;
      status.textContent = '';
      try {
        await navigator.share(data);
      } catch (error) {
        if (!(error instanceof Error && error.name === 'AbortError')) {
          status.textContent = container.dataset.failed!;
        }
      } finally {
        share.disabled = false;
      }
    });

    copy.addEventListener('click', async () => {
      status.textContent = '';
      try {
        await navigator.clipboard.writeText(url);
        manual.hidden = true;
        status.textContent = container.dataset.copied!;
      } catch {
        manual.hidden = false;
        input.value = url;
        input.focus();
        input.select();
        status.textContent = container.dataset.manual!;
      }
    });
  }
</script>

<style>
  .article-share { margin-top: 1.5rem; }
  .article-share__buttons { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .article-share [hidden] { display: none; }
  button {
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--ink);
    background: transparent;
    color: var(--ink);
    font-weight: 700;
    cursor: pointer;
  }
  button:hover { background: #ece9df; }
  button:focus-visible, input:focus-visible { outline: 2px solid #794000; outline-offset: 3px; }
  button:disabled { cursor: wait; }
  .article-share__status { min-height: 1.6em; margin: 0.4rem 0 0; font-size: 0.85rem; }
  .article-share__manual { display: grid; gap: 0.4rem; max-width: 36rem; font-size: 0.85rem; }
  input { width: 100%; min-width: 0; padding: 0.6rem; border: 1px solid var(--ink); background: var(--paper); color: var(--ink); }
</style>
