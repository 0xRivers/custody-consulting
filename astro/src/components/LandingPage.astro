---
import { Image } from 'astro:assets';
import { buildEnvironment } from '../../environment.mjs';
import hero from '../../../src/assets/hero-vault.jpg';
import foundationPhoto from '../../../src/assets/services/foundation.jpg';
import essentialsPhoto from '../../../src/assets/services/essentials.jpg';
import transactionPhoto from '../../../src/assets/services/transactions.jpg';
import continuityPhoto from '../../../src/assets/services/continuity.jpg';
const servicePhotos=[foundationPhoto,essentialsPhoto,transactionPhoto,continuityPhoto];
import Base from '../layouts/Base.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import { alternateLocale, getContent, type Locale } from '../lib/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getContent(lang);
const alternate = alternateLocale(lang);
const discoveryUrl = buildEnvironment(process.env.SITE_ENV).name === 'staging'
  ? 'https://cal.com/custody.consulting/discovery'
  : undefined;
const discoveryLabel = lang === 'pl' ? 'Umów bezpłatną rozmowę (15 min)' : 'Book a free discovery call (15 min)';
---
<Base
  title={t.meta.title}
  description={t.meta.description}
  lang={lang}
  canonicalPath={`/${lang}/`}
  alternatePaths={[{ lang, path: `/${lang}/` }, { lang: alternate, path: `/${alternate}/` }]}
  xDefaultPath="/"
>
  <SiteHeader lang={lang} primaryAction={discoveryUrl ? { href: discoveryUrl, label: discoveryLabel } : undefined} />

  <main id="content">
    <section id="top" class="hero">
      <Image
        src={hero}
        alt=""
        class="hero__image"
        widths={[480, 768, 1200, 1600]}
        sizes="100vw"
        format="webp"
        quality={72}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <div class="hero__wash"></div>
      <div class="shell hero__content">
        <p class="eyebrow"><span class="dot"></span>{t.hero.eyebrow}</p>
        <h1>{t.hero.title}</h1>
        <p class="hero__lead">{t.hero.sub}</p>
        <div class="button-row">
          <a class="button" href={discoveryUrl ?? '#services'}>{discoveryUrl ? discoveryLabel : t.hero.cta}</a>
          <a class="button button--ghost" href={discoveryUrl ? '#services' : '#process'}>{discoveryUrl ? t.hero.cta : t.hero.cta2}</a>
        </div>
        <ul class="signals" aria-label={lang === 'pl' ? 'Najważniejsze zasady' : 'Key principles'}>
          {t.hero.signals.map((signal) => <li><span class="dot"></span>{signal}</li>)}
        </ul>
      </div>
    </section>

    <section id="why" class="section shell">
      <span id="approach" aria-hidden="true"></span>
      <p class="section-label">{t.why.label}</p>
      <h2>{t.why.title}</h2>
      <p class="section-intro">{t.why.sub}</p>
      <div class="principles">
        {t.why.items.map((item, index) => (
          <article>
            <span class="index">0{index + 1}</span>
            <h3>{item.t}</h3>
            <p>{item.d}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="who" class="section shell" aria-labelledby="who-title">
      <span id="audiences" aria-hidden="true"></span>
      <h2 id="who-title">{t.audience.title}</h2>
      <p class="section-intro">{t.audience.sub}</p>
      <div class="audience-grid">
        {t.audience.items.map((item, index) => (
          <article>
            <span class="index" aria-hidden="true">0{index + 1}</span>
            <h3>{item.t}</h3>
            <p>{item.d}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="services" class="section section--paper">
      <div class="shell">
        <h2>{t.services.title}<span class="accent">.</span></h2>
        <p class="section-intro">{t.services.sub}</p>
        <div class="services-grid">
          {t.services.items.map((service, index) => (
            <article class="service-card">
              <Image src={servicePhotos[index]} alt="" class="service-photo" width={1100} widths={[480, 768, 1100]} sizes="(max-width: 760px) 100vw, 50vw" format="webp" quality={65} loading="lazy" decoding="async" />
              <div class="service-body">
                <p class="service-meta">{service.meta}</p>
                <h3>{service.t}</h3>
                <p class="service-description">{service.d}</p>
                <p class="service-outcome">{service.outcome}</p>
              </div>
            </article>
          ))}
        </div>
        <p class="fine-print">{t.services.note}</p>
      </div>
    </section>

    <section id="process" class="section shell">
      <span id="steps" aria-hidden="true"></span>
      <h2>{t.process.title}</h2>
      <ol class="process-grid">
        {t.process.steps.map((step, index) => (
          <li>
            <span class="process-number">{index + 1}</span>
            <h3>{step.t}</h3>
            <p>{step.d}</p>
          </li>
        ))}
      </ol>
      <aside class="trust-panel">
        <h3><span class="dot"></span>{t.trust.title}</h3>
        <p>{t.trust.d}</p>
        <p class="trust-note">{t.trust.note}</p>
      </aside>
    </section>

    <section id="faq" class="section faq shell shell--narrow">
      <span id="questions" aria-hidden="true"></span>
      <h2>{t.faq.title}</h2>
      <div class="faq-list">
        {t.faq.items.map((item) => (
          <details>
            <summary>{item.q}<span aria-hidden="true">+</span></summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section id="contact" class="section contact">
      <div class="shell contact__grid">
        <div>
          <h2>{t.contact.title}</h2>
          <p class="contact__lead">{t.contact.sub}</p>
          <p class="contact__privacy">{t.contact.privacy}</p>
        </div>
        <aside class="contact-card">
          <h3>{t.contact.panelTitle}</h3>
          <ul>
            {t.contact.prompts.map((prompt) => <li><span aria-hidden="true">→</span>{prompt}</li>)}
          </ul>
          <div class="contact-card__status">
            {discoveryUrl ? (
              <a class="button" href={discoveryUrl}>
                {discoveryLabel}
              </a>
            ) : (
              <>
                <strong>{t.contact.status}</strong>
                <p>{t.contact.availability}</p>
              </>
            )}
          </div>
        </aside>
      </div>
    </section>
  </main>

  <SiteFooter lang={lang} />
</Base>
