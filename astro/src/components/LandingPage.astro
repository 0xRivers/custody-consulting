---
import { Image } from 'astro:assets';
import hero from '../../../src/assets/hero-vault.jpg';
import Base from '../layouts/Base.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import { alternateLocale, getContent, type Locale } from '../lib/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getContent(lang);
const alternate = alternateLocale(lang);
---
<Base
  title={t.meta.title}
  description={t.meta.description}
  lang={lang}
  canonicalPath={`/${lang}/`}
  alternatePaths={[{ lang, path: `/${lang}/` }, { lang: alternate, path: `/${alternate}/` }]}
  xDefaultPath="/"
>
  <SiteHeader lang={lang} />

  <main id="content">
    <section id="top" class="hero">
      <Image src={hero} alt="" class="hero__image" loading="eager" fetchpriority="high" />
      <div class="hero__wash"></div>
      <div class="shell hero__content">
        <p class="eyebrow"><span class="dot"></span>{t.hero.eyebrow}</p>
        <h1>{t.hero.title}</h1>
        <p class="hero__lead">{t.hero.sub}</p>
        <div class="button-row">
          <a class="button" href="#services">{t.hero.cta}</a>
          <a class="button button--ghost" href="#process">{t.hero.cta2}</a>
        </div>
        <ul class="signals" aria-label={lang === 'pl' ? 'Najważniejsze zasady' : 'Key principles'}>
          {t.hero.signals.map((signal) => <li><span class="dot"></span>{signal}</li>)}
        </ul>
      </div>
    </section>

    <section id="why" class="section shell">
      <p class="section-label">{t.why.label}</p>
      <h2>{t.why.title}</h2>
      <p class="section-intro">{t.why.sub}</p>
      <div class="principles">
        {t.why.items.map((item, index) => (
          <article>
            <span class="index">0{index + 1}</span>
            <h3>{item.t}</h3>
            <p>{item.d}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="services" class="section section--paper">
      <div class="shell">
        <h2>{t.services.title}<span class="accent">.</span></h2>
        <p class="section-intro">{t.services.sub}</p>
        <div class="services-grid">
          {t.services.items.map((service) => (
            <article>
              <h3>{service.t}</h3>
              <p>{service.d}</p>
              <p class="service-outcome">{service.outcome}</p>
              <p class="service-price">{service.p}</p>
            </article>
          ))}
        </div>
        <p class="fine-print">{t.services.note}</p>
      </div>
    </section>

    <section id="process" class="section shell">
      <h2>{t.process.title}</h2>
      <ol class="process-grid">
        {t.process.steps.map((step, index) => (
          <li>
            <span class="process-number">{index + 1}</span>
            <h3>{step.t}</h3>
            <p>{step.d}</p>
          </li>
        ))}
      </ol>
      <aside class="trust-panel">
        <h3><span class="dot"></span>{t.trust.title}</h3>
        <p>{t.trust.d}</p>
        <p class="trust-note">{t.trust.note}</p>
      </aside>
    </section>

    <section id="faq" class="section faq shell shell--narrow">
      <h2>{t.faq.title}</h2>
      <div class="faq-list">
        {t.faq.items.map((item) => (
          <details>
            <summary>{item.q}<span aria-hidden="true">+</span></summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section id="contact" class="section contact">
      <div class="shell contact__grid">
        <div>
          <h2>{t.contact.title}</h2>
          <p class="contact__lead">{t.contact.sub}</p>
          <p class="contact__privacy">{t.contact.privacy}</p>
        </div>
        <aside class="contact-card">
          <h3>{t.contact.panelTitle}</h3>
          <ul>
            {t.contact.prompts.map((prompt) => <li><span aria-hidden="true">→</span>{prompt}</li>)}
          </ul>
          <div class="contact-card__status">
            <strong>{t.contact.status}</strong>
            <p>{t.contact.availability}</p>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <SiteFooter lang={lang} />
</Base>
