<section id="sales-panel" class="sales-page" aria-labelledby="sales-title" hidden>
  <header class="sales-heading"><div><p class="sales-eyebrow">BUSINESS OVERVIEW</p><h1 id="sales-title">Sales</h1><p id="sales-scope">Bookings, payments and cases that need your attention.</p></div><button id="load-sales" class="sales-button sales-primary" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5M5.6 7a7 7 0 0 1 11.8-2L20 8M4 16l2.6 3A7 7 0 0 0 18.4 17"/></svg>Refresh sales</button></header>
  <div class="ledger-surface">
    <form id="sales-filters" class="ledger-toolbar" role="search"><label class="sales-search">Search sales<input id="sales-search" type="search" placeholder="Booking or payment ID" maxlength="120" autocomplete="off"/></label><label>Status<select id="sales-filter"><option value="all">All statuses</option><option id="sales-review-option" value="review" hidden>Needs review</option><option value="confirmed">Confirmed</option><option value="pending">Awaiting payment</option><option value="closed">Closed</option></select></label><button class="sales-button" type="submit">Apply filters</button></form>
    <div class="ledger-meta"><p id="sales-count" role="status" aria-live="polite">Connect to load sales.</p><p id="sales-basis">Amounts are shown in their original currency.</p></div>
    <p id="sales-message" class="sales-message" role="status" aria-live="polite" hidden></p>
    <div class="ledger-scroll" tabindex="0" role="region" aria-label="Sales table, scroll horizontally on small screens"><table id="sales-table"><caption class="sales-sr-only">Sales and payment review cases. Use each row’s action to view details.</caption><thead><tr><th scope="col">Booking</th><th scope="col">Appointment</th><th scope="col" class="amount-column">Amount</th><th scope="col">Method</th><th scope="col">Status</th><th scope="col"><span class="sales-sr-only">Actions</span></th></tr></thead><tbody id="sales-rows"><tr><td colspan="6" class="sales-empty">Your sales will appear here.</td></tr></tbody></table></div>
    <footer class="ledger-pagination"><span id="sales-page-label">Page 1</span><div><button id="sales-previous" class="sales-button" type="button" disabled>Previous</button><button id="sales-next" class="sales-button" type="button" disabled>Next</button></div></footer>
  </div>
</section>
<style>
.sales-page{--sales-pad:1rem;--ledger-radius:.75rem;color:#14243a;background:#f4f5f7;color-scheme:light;border-radius:calc(var(--sales-pad) + var(--ledger-radius));padding:var(--sales-pad);min-width:0}.sales-heading{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem}.sales-heading h1{color:#102139;font-size:clamp(1.9rem,4vw,2.6rem);line-height:1.2;letter-spacing:-.035em;margin:0 0 .5rem}.sales-heading p{color:#475569;margin:.35rem 0 0;line-height:1.6}.sales-heading .sales-eyebrow{color:#82500d;letter-spacing:.12em;font-size:.7rem;font-weight:750;margin:0 0 .6rem}.sales-page :global(.sales-button){display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:44px;padding:.65rem .9rem;background:#fff;color:#17304f;border:1px solid #7e8da2;border-radius:6px;font:650 .875rem/1.4 ui-sans-serif,system-ui,sans-serif;cursor:pointer;text-decoration:none}.sales-button svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2.25;stroke-linecap:round;stroke-linejoin:round}.sales-page :global(.sales-primary){color:#fff;background:#17304f;border-color:#17304f}.sales-page :global(button:disabled){color:#607087;background:#eef1f5;border-color:#d3dbe5;cursor:not-allowed}.ledger-surface{background:#fff;border:1px solid transparent;border-radius:var(--ledger-radius);box-shadow:0 0 0 1px oklch(0 0 0/.06),0 1px 2px -1px oklch(0 0 0/.06),0 2px 4px oklch(0 0 0/.04);overflow:hidden}.ledger-toolbar{display:flex;flex-wrap:wrap;gap:1rem;align-items:end;padding:1.25rem;border-bottom:1px solid #d9e0e8}.ledger-toolbar label{display:grid;gap:.4rem;font-size:.8rem;font-weight:650;color:#334d6c;min-width:0;margin:0}.sales-search{flex:1 1 17rem}.ledger-toolbar input,.ledger-toolbar select{font:400 1rem/1.5 ui-sans-serif,system-ui,sans-serif;min-width:0;min-height:44px;width:100%;border:1px solid #7e8da2;border-radius:6px;background:#fff;color:#14243a;padding:.6rem .75rem}.ledger-toolbar input::placeholder{color:#607087;opacity:1}.ledger-meta{display:flex;align-items:baseline;justify-content:space-between;gap:.6rem 1.5rem;flex-wrap:wrap;padding:.9rem 1.25rem}.ledger-meta p{font-size:.8rem;line-height:1.5;margin:0;color:#475569}#sales-count{font-weight:650;color:#23364f}.ledger-scroll{max-width:100%;overflow-x:auto;overscroll-behavior:contain}.sales-page table{width:100%;border-collapse:collapse;min-width:52rem;background:#fff;color:#14243a;font-size:.875rem}.sales-page th{text-align:left;color:#475569;font-size:.75rem;font-weight:700;background:#f5f7fa;padding:.85rem 1rem;border-block:1px solid #d9e0e8;white-space:nowrap}.sales-page :global(td){padding:1rem;border-bottom:1px solid #e2e8f0;vertical-align:middle;line-height:1.5}.sales-page :global(.amount-column){text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}.sales-page :global(.sale-reference){font-family:ui-monospace,SFMono-Regular,monospace;font-size:.8rem;display:block;max-width:17rem;overflow-wrap:anywhere}.sales-page :global(.sale-secondary){display:block;color:#607087;font-size:.75rem;margin-top:.3rem}.sales-page :global(.sale-status){display:inline-flex;align-items:center;gap:.4rem;padding:.3rem .6rem;border:1px solid currentColor;border-radius:4px;font-size:.75rem;font-weight:650;white-space:nowrap}.sales-page :global(.sale-status-review){color:#805009;background:#fff7e8}.sales-page :global(.sale-status-confirmed){color:#246044;background:#edf8f1}.sales-page :global(.sale-status-pending),.sales-page :global(.sale-status-closed){color:#475569;background:#f1f4f8}.sales-page :global(.sale-action){white-space:nowrap}.sales-page :global(.sale-action button){min-width:8.5rem}.sales-page :global(.sale-detail-cell){background:#f7f9fb;padding:1.25rem;white-space:normal}.sales-page :global(.sale-detail-cell p){color:#475569;font-size:.875rem;margin:.35rem 0;line-height:1.6;overflow-wrap:anywhere}.sales-page :global(.sale-detail-cell h3){color:#14243a;font:700 1rem/1.5 ui-sans-serif,system-ui,sans-serif;margin:0 0 .6rem}.sales-page :global(.sale-detail-cell label){display:grid;gap:.4rem;color:#23364f;font-size:.875rem;max-width:25rem;margin:1rem 0 .5rem}.sales-page :global(.sale-detail-cell input){min-height:44px;font:inherit;background:#fff;color:#14243a;border:1px solid #7e8da2;border-radius:6px;padding:.6rem .75rem;min-width:0;max-width:100%}.sales-page :global(.sale-detail-cell button){margin:.5rem .5rem .5rem 0}.sales-page :global(.sales-empty){text-align:center;padding:3rem 1rem;color:#475569}.ledger-pagination{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.25rem;color:#475569;font-size:.8rem}.ledger-pagination>div{display:flex;gap:.5rem}.sales-message{margin:0;padding:1rem 1.25rem;background:#fff7e8;color:#805009;font-size:.875rem}.sales-page :global(:is(button,input,select):focus-visible),.ledger-scroll:focus-visible{outline:3px solid #1263ad;outline-offset:3px}.sales-sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.sales-page :global([hidden]){display:none!important}
@media(hover:hover){.sales-page :global(.sales-button:not(:disabled):hover){background:#edf2f7;border-color:#334d6c}.sales-page :global(.sales-primary:not(:disabled):hover){background:#234c7d;color:#fff}.sales-page :global(.sale-row:hover){background:#f8fafc}}
@media(prefers-reduced-motion:no-preference){.sales-page :global(.sales-button){transition:scale 150ms ease-out,background-color 150ms ease-out}.sales-page :global(.sales-button:not(:disabled):active){scale:.96}.sales-page :global(.sale-row){transition:background-color 100ms ease-out}}
@media(max-width:40rem){.sales-page{padding:1rem}.ledger-toolbar{padding:1rem;gap:.75rem}.ledger-toolbar label{flex:1 1 100%}.ledger-toolbar>.sales-button{width:100%}.sales-heading>.sales-button{width:100%}.ledger-meta,.ledger-pagination{padding:1rem}.ledger-pagination{flex-wrap:wrap}.ledger-pagination>div{margin-left:auto}}
</style>
