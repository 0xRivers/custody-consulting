---
import { buildEnvironment } from '../../environment.mjs';
const environment = buildEnvironment(process.env.SITE_ENV);
const { title, lang = 'en' } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {!environment.indexable && <meta name="robots" content="noindex, nofollow, noarchive" />}
  </head>
  <body><slot /></body>
</html>
