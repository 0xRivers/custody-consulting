---
import { buildEnvironment } from '../../environment.mjs';
import favicon from '../../../public/favicon.png';
import { buildMetadataLinks, type AlternatePath } from '../lib/metadata';
import { serializeStructuredData } from '../lib/structured-data';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'pl';
  bodyClass?: string;
  noindex?: boolean;
  canonicalPath?: string;
  alternatePaths?: AlternatePath[];
  xDefaultPath?: string;
  feedPath?: string;
  feedTitle?: string;
  structuredData?: unknown;
}

const environment = buildEnvironment(process.env.SITE_ENV);
const {
  title,
  description,
  lang = 'en',
  bodyClass = '',
  noindex = false,
  canonicalPath,
  alternatePaths,
  xDefaultPath,
  feedPath,
  feedTitle,
  structuredData,
} = Astro.props;
const metadataLinks = buildMetadataLinks({
  indexable: environment.indexable,
  noindex,
  site: environment.site,
  canonicalPath,
  alternatePaths,
  xDefaultPath,
});
if (feedPath && !feedPath.startsWith('/')) throw new Error(`Feed path must be site-relative: ${feedPath}`);
const feedUrl = environment.indexable && !noindex && feedPath ? new URL(feedPath, environment.site).href : undefined;
const structuredDataJson = environment.indexable && !noindex && structuredData
  ? serializeStructuredData(structuredData)
  : undefined;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={favicon.src} />
    {description && <meta name="description" content={description} />}
    {metadataLinks.canonical && <link rel="canonical" href={metadataLinks.canonical} />}
    {metadataLinks.alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
    {feedUrl && <link rel="alternate" type="application/rss+xml" title={feedTitle ?? 'RSS'} href={feedUrl} />}
    <meta property="og:site_name" content="Custody Consulting" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {metadataLinks.canonical && <meta property="og:url" content={metadataLinks.canonical} />}
    <meta property="og:locale" content={lang === 'pl' ? 'pl_PL' : 'en_GB'} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#061631" />
    {(!environment.indexable || noindex) && <meta name="robots" content="noindex, nofollow, noarchive" />}
    {structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson}></script>}
  </head>
  <body class={bodyClass}><slot /></body>
</html>
